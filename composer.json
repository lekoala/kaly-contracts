{
    "name": "lekoala/kaly-contracts",
    "description": "Stable interfaces shared by Kaly and its packages: task dispatching, template rendering",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Thomas",
            "email": "thomas@lekoala.be"
        }
    ],
    "keywords": [
        "kaly",
        "contracts",
        "tasks",
        "view"
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3"
    },
    "conflict": {
        "lekoala/kaly": "<0.9"
    },
    "autoload": {
        "psr-4": {
            "Kaly\\Task\\": "src/Task/",
            "Kaly\\View\\": "src/View/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@lint",
            "@contracts",
            "@phpstan"
        ],
        "lint": "find src -name '*.php' -print0 | xargs -0 -n1 php -l",
        "contracts": "php tests/contracts.php",
        "phpstan": "phpstan analyse src --memory-limit=-1"
    },
    "prefer-stable": true
}
